# Copy to .env (gitignored) and fill in real values before running the sidecar.
#
# OpenAI key for embeddings + chat completions. The sidecar reads this via
# python-dotenv at startup; nothing else loads dotenv automatically.
OPENAI_API_KEY=sk-...

# Qdrant connection. Defaults to localhost:6333 when running docker compose up.
QDRANT_URL=http://localhost:6333

# Optional model overrides. Defaults documented in docchat_sidecar/__main__.py.
# DOCCHAT_EMBED_MODEL=text-embedding-3-small
# DOCCHAT_CHAT_MODEL=gpt-4o-mini
